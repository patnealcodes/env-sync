# env-sync CLI preferences. Declare source and target paths in .envsync.json.
# Use true or false. HELP prints usage instead of syncing any files.
ENV_SYNC_JSON=false
ENV_SYNC_NO_BACKUP=false
ENV_SYNC_HELP=false

# Absolute private directory outside Git. Blank uses the home-directory default.
# Exported ENV_SYNC_* options take precedence over this file.
ENV_SYNC_BACKUP_DIR=
